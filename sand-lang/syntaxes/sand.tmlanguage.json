{
    "scopeName": "source.sand",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#keywords"
        }
    ],
    "repository": {
        "comments": {
            "name": "comment.line.double‑slash.sand",
            "match": "//.*$"
        },
        "strings": {
            "name": "string.quoted.double.sand",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "match": "\\\\.",
                    "name": "constant.character.escape.sand"
                }
            ]
        },
        "numbers": {
            "name": "constant.numeric.sand",
            "match": "-?\\b\\d+(\\.\\d+)?\\b"
        },
        "operators": {
            "name": "keyword.operator.sand",
            "match": "[=+\\-*/<>]"
        },
        "keywords": {
            "name": "keyword.control.sand",
            "match": "\\b(if|else|while|for|in|func|return|break|continue|output|input|range|begin|end|from|import|tonum|prminput|outputLine|class|new|static|super|init|tostring|and|or|not|lambda)\\b"
        }
    }
}