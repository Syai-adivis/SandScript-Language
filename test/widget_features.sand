declare func calculate(n);

func onButtonClicked() begin
    outputLine("Button clicked");
end

calculate = lambda (n) begin
    return n * 2
end

declare class BaseBox;

widget class Panel:Window {
    export property title = "Exported Panel"
    export property width = 640
    export property height = 480
    export signal closed
}

widget Panel {
    property title = "Custom Panel"
}

widget Button {
    property text = "Click me"
    slot clicked >> onButtonClicked
}
