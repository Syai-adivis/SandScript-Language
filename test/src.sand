
class Person begin
    func init(name) begin
        self.name = name;
    end
    func say() begin
        outputLine("Person say: ");
        outputLine(self.name);
    end
end

class Student : Person begin
    func init(name, id) begin
        super.init(name);
        self.id = id;
    end
    
    func say() begin
        outputLine("Student override say:",self.name,"\n",self.id);
    end
end

s = new Student("zhangsan", 1001);
s.say(); 
num=tonum(prminput("input a number:"));
sum=0;
for i in range(1,num+1) begin
    sum=sum+(i*i);
    outputLine(sum);
end
output(sum);