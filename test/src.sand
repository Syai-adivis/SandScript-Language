t1 = time();
outputLine(tostring(t1));
tms1 = time_ms();
outputLine(tostring(tms1));
sleep(1200);
tms2 = time_ms();
outputLine(tostring(tms2));
outputLine(tostring(tms2 - tms1));

num=tonum(prminput("input a number:"));
sum=0;
for i in range(1,num+1) begin
    sum=sum+(i*i);
    outputLine(sum);
end
output(sum);